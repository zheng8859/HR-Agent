# HR Agent 生产环境变量模板
# 用法: cp .env.production.example .env.production 并填入真实值
# 注意: .env.production 已被 .gitignore 排除，切勿提交真实密钥
# 生成强随机 SECRET_KEY:  openssl rand -hex 32

# === PostgreSQL（docker-compose.prod.yml 的 postgres 服务） ===
POSTGRES_USER=hragent
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__
POSTGRES_DB=hragent

# === 后端数据库连接（backend 服务读取；host 指向 compose 服务名 postgres） ===
DATABASE_URL=postgresql+asyncpg://hragent:__CHANGE_ME_STRONG_PASSWORD__@postgres:5432/hragent

# === 安全（生产必须替换默认值，否则 JWT 可被伪造） ===
SECRET_KEY=__CHANGE_ME_RANDOM_32_BYTES_HEX__

# === RAG 检索 ===
RAG_MIN_SIMILARITY_SCORE=0.2

# === 外部 AI 服务（生产必须配置真实值；未配置时各服务降级为 mock，非生产行为） ===
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=60

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-turbo

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
