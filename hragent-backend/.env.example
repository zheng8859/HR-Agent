# 数据库（POSTGRES_* 仅供 docker-compose，勿写入 .env——Settings 会拒绝额外字段）
DATABASE_URL=postgresql+asyncpg://hragent:hragent_dev_password@localhost:5432/hragent

# 安全（生产必须替换）
SECRET_KEY=change-me-in-production

# RAG
RAG_MIN_SIMILARITY_SCORE=0.2

# 外部 AI 服务（未配置时各服务走 mock）
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=60

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-turbo

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
